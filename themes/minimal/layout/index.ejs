<%
  const home = theme.home || {};
  const socialLinks = home.social_links || [];
  const skills = home.skills || [];
  const languages = home.languages || [];
  const homeTitle = home.title || '这是一个可能记录日常的blog';
  const homeSubtitle = home.subtitle || config.subtitle;
  const intro = home.intro || (config.description ? [config.description] : []);
%>

<section class="home-hero">
  <p class="eyebrow"><%= home.eyebrow || 'About Me' %></p>
  <h1><%= homeTitle %></h1>
  <% if (homeSubtitle) { %><p class="home-subtitle"><%- homeSubtitle %></p><% } %>

  <% if (socialLinks.length) { %>
    <div class="social-links" aria-label="外部链接">
      <% socialLinks.forEach(function(link) { %>
        <a href="<%- link.url %>" target="_blank" rel="noopener noreferrer"><%= link.name %></a>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="home-grid" aria-label="个人信息">
  <article class="info-panel intro-panel">
    <h2> </h2>
    <% if (intro.length) { %>
      <% intro.forEach(function(paragraph) { %>
        <p><%- paragraph %></p>
      <% }) %>
    <% } %>
  </article>

  <% if (skills.length) { %>
    <article class="info-panel">
      <h2>擅长的技术</h2>
      <div class="chip-list">
        <% skills.forEach(function(skill) { %>
          <span><%= skill %></span>
        <% }) %>
      </div>
    </article>
  <% } %>

  <% if (languages.length) { %>
    <article class="info-panel">
      <h2>languages</h2>
      <div class="language-list">
        <% languages.forEach(function(language) { %>
          <div class="language-item">
            <span><%= language.name %></span>
            <% if (language.level) { %><strong><%= language.level %></strong><% } %>
          </div>
        <% }) %>
      </div>
    </article>
  <% } %>
</section>

<section class="home-posts" aria-label="最近文章">
  <div class="section-title">
    <p class="eyebrow">Latest Posts</p>
    <h2>最近文章</h2>
    <a href="<%- url_for('/archives/') %>">查看归档</a>
  </div>

  <div class="post-list compact">
    <% page.posts.limit(3).each(function(post) { %>
      <article class="post-card">
        <%- partial('_partial/post-time', { item: post }) %>
        <h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
        <% if (post.excerpt) { %>
          <div class="excerpt"><%- post.excerpt %></div>
        <% } else { %>
          <div class="excerpt"><%= truncate(strip_html(post.content), { length: 120 }) %></div>
        <% } %>
        <a class="read-more" href="<%- url_for(post.path) %>">阅读全文</a>
      </article>
    <% }) %>
  </div>
</section>
